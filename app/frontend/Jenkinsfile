pipeline {
    agent any

    stages {
        stage('Portal Web Pipeline') {
            when {
                anyOf {
                    changeset "frontend/**"
                    triggeredBy 'UserIdCause'
                }
            }

            stages {
                stage('Build') {
                    agent {
                        docker { 
                            image 'node:22-alpine' 
                            reuseNode true
                        }
                    }
                    steps {
                        dir('frontend') {
                            sh 'npm install && npm run build'
                        }
                    }
                }

                stage('Test') {
                    agent {
                        docker { 
                            image 'node:22-alpine' 
                            reuseNode true
                        }
                    }
                    steps {
                        dir('frontend') {
                            sh 'npm run test'
                        }
                    }
                }

                stage('Detect Changes') {
                    steps {
                        script {
                            def changedFiles = sh(
                                script: "git diff --name-only HEAD~1 -- frontend/ || echo 'frontend/'",
                                returnStdout: true
                            ).trim()

                            // Shared code or config changes affect all apps
                            def deployAll = changedFiles.contains('frontend/src/shared/') ||
                                            changedFiles.contains('frontend/vite.config.ts') ||
                                            changedFiles.contains('frontend/package.json') ||
                                            changedFiles.contains('frontend/.env') ||
                                            changedFiles.contains('frontend/tsconfig')

                            env.DEPLOY_LANDING = (deployAll || changedFiles.contains('frontend/src/landing/') || changedFiles.contains('frontend/landing.html')) ? 'true' : 'false'
                            env.DEPLOY_LOGIN   = (deployAll || changedFiles.contains('frontend/src/login/')   || changedFiles.contains('frontend/login.html'))   ? 'true' : 'false'
                            env.DEPLOY_STUDENT = (deployAll || changedFiles.contains('frontend/src/student/') || changedFiles.contains('frontend/student.html')) ? 'true' : 'false'
                            env.DEPLOY_PARENT  = (deployAll || changedFiles.contains('frontend/src/parent/')  || changedFiles.contains('frontend/parent.html'))  ? 'true' : 'false'
                            env.DEPLOY_FACULTY = (deployAll || changedFiles.contains('frontend/src/faculty/') || changedFiles.contains('frontend/faculty.html')) ? 'true' : 'false'

                            echo "Deploy flags => landing:${env.DEPLOY_LANDING} login:${env.DEPLOY_LOGIN} student:${env.DEPLOY_STUDENT} parent:${env.DEPLOY_PARENT} faculty:${env.DEPLOY_FACULTY}"
                        }
                    }
                }

                stage('Deploy') {
                    agent {
                        docker { 
                            image 'amazon/aws-cli' 
                            args '--entrypoint=""' // Override entrypoint so Jenkins can run sh commands
                            reuseNode true
                        }
                    }
                    steps {
                        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials-id', accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                            dir('frontend') {
                                script {
                                    def deploySteps = [:]

                                    if (env.DEPLOY_LANDING == 'true') {
                                        deploySteps['Deploy Landing'] = {
                                            sh "aws s3 sync dist/landing s3://${LANDING_S3_BUCKET} --delete --region ${AWS_REGION} --no-progress"
                                            sh "aws cloudfront create-invalidation --distribution-id ${LANDING_CF_ID} --paths '/*' --region ${AWS_REGION}"
                                        }
                                    }
                                    if (env.DEPLOY_LOGIN == 'true') {
                                        deploySteps['Deploy Login'] = {
                                            sh "aws s3 sync dist/login s3://${LOGIN_S3_BUCKET} --delete --region ${AWS_REGION} --no-progress"
                                            sh "aws cloudfront create-invalidation --distribution-id ${LOGIN_CF_ID} --paths '/*' --region ${AWS_REGION}"
                                        }
                                    }
                                    if (env.DEPLOY_STUDENT == 'true') {
                                        deploySteps['Deploy Student'] = {
                                            sh "aws s3 sync dist/student s3://${STUDENT_S3_BUCKET} --delete --region ${AWS_REGION} --no-progress"
                                            sh "aws cloudfront create-invalidation --distribution-id ${STUDENT_CF_ID} --paths '/*' --region ${AWS_REGION}"
                                        }
                                    }
                                    if (env.DEPLOY_PARENT == 'true') {
                                        deploySteps['Deploy Parent'] = {
                                            sh "aws s3 sync dist/parent s3://${PARENT_S3_BUCKET} --delete --region ${AWS_REGION} --no-progress"
                                            sh "aws cloudfront create-invalidation --distribution-id ${PARENT_CF_ID} --paths '/*' --region ${AWS_REGION}"
                                        }
                                    }
                                    if (env.DEPLOY_FACULTY == 'true') {
                                        deploySteps['Deploy Faculty'] = {
                                            sh "aws s3 sync dist/faculty s3://${FACULTY_S3_BUCKET} --delete --region ${AWS_REGION} --no-progress"
                                            sh "aws cloudfront create-invalidation --distribution-id ${FACULTY_CF_ID} --paths '/*' --region ${AWS_REGION}"
                                        }
                                    }

                                    if (deploySteps.size() > 0) {
                                        parallel deploySteps
                                    } else {
                                        echo 'No app changes detected — skipping deploy.'
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
