### PECTOP API Requests (REST Client / IntelliJ HTTP Client)
# Tip: Execute the login requests first. Variables will capture the tokens automatically!

@baseUrl = http://localhost:3000
@defaultPassword = password123

###############################################################################
# 1. AUTHENTICATION & LOGIN (ALL 8 ROLES)
###############################################################################

### List all test accounts
GET {{baseUrl}}/auth/test-users

### 1.1 Login as Student
# @name loginStudent
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "111422104001",
  "password": "{{defaultPassword}}"
}

### Save Student Token
@studentToken = {{loginStudent.response.body.accessToken}}


### 1.2 Login as Mentor
# @name loginMentor
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "mentor1",
  "password": "{{defaultPassword}}"
}

### Save Mentor Token
@mentorToken = {{loginMentor.response.body.accessToken}}


### 1.3 Login as Faculty
# @name loginFaculty
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "faculty1",
  "password": "{{defaultPassword}}"
}

### Save Faculty Token
@facultyToken = {{loginFaculty.response.body.accessToken}}


### 1.4 Login as Class Coordinator
# @name loginCoordinator
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "coordinator1",
  "password": "{{defaultPassword}}"
}

### Save Coordinator Token
@coordinatorToken = {{loginCoordinator.response.body.accessToken}}


### 1.5 Login as HOD
# @name loginHOD
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "hod_cse",
  "password": "{{defaultPassword}}"
}

### Save HOD Token
@hodToken = {{loginHOD.response.body.accessToken}}


### 1.6 Login as Principal
# @name loginPrincipal
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "principal",
  "password": "{{defaultPassword}}"
}

### Save Principal Token
@principalToken = {{loginPrincipal.response.body.accessToken}}


### 1.7 Login as Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "{{defaultPassword}}"
}

### Save Admin Token
@adminToken = {{loginAdmin.response.body.accessToken}}


### 1.8 Login as Parent
# @name loginParent
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "parent1",
  "password": "{{defaultPassword}}"
}

### Save Parent Token
@parentToken = {{loginParent.response.body.accessToken}}


### 1.9 Verify Current Profile (with Student Token)
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{studentToken}}


###############################################################################
# 2. STUDENT MODULE (/students) — FULL DATABASE INTEGRATION
###############################################################################

### 2.1 Admin onboards a new student (Booklet Front Cover)
POST {{baseUrl}}/students/onboard
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "registerNumber": "111422104005",
  "admissionNumber": "PEC2022CSE050",
  "name": "Divya Bharathi R.",
  "branch": "CSE",
  "batchStart": 2022,
  "batchEnd": 2026,
  "section": "A",
  "admissionType": "COUNSELING",
  "lateralEntry": false,
  "studentPhotoUrl": "https://storage.pec.edu/photos/111422104005_adm.jpg"
}

### 2.2 Student views their own full profile dossier
GET {{baseUrl}}/students/me
Authorization: Bearer {{studentToken}}

### 2.3 Mentor or Faculty views student dossier by Register Number
GET {{baseUrl}}/students/profile/111422104001
Authorization: Bearer {{mentorToken}}

### 2.4 List & filter students (by branch, section, search)
GET {{baseUrl}}/students?branch=CSE&section=A
Authorization: Bearer {{mentorToken}}

