###############################################################################
# 3. ACADEMIC MODULE (/academic) — FULL DATABASE INTEGRATION (PAGE C)
###############################################################################

### 3.1 Admin / Coordinator creates an Academic Class
POST {{baseUrl}}/academic/classes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "department": "CSE",
  "year": 2,
  "semester": 4,
  "section": "B",
  "academicYear": "2024-2025"
}

### 3.2 List Academic Classes
GET {{baseUrl}}/academic/classes?department=CSE
Authorization: Bearer {{coordToken}}

### 3.3 Admin creates a Subject in Catalog
POST {{baseUrl}}/academic/subjects
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "code": "CS8491",
  "name": "Computer Architecture",
  "department": "CSE",
  "credits": 3,
  "type": "THEORY"
}

### 3.4 List Subjects in Catalog
GET {{baseUrl}}/academic/subjects?department=CSE
Authorization: Bearer {{coordToken}}

### 3.5 Coordinator initializes Semester 4 Scorecard for a Student (Page C)
POST {{baseUrl}}/academic/performance/init
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "studentId": "111422104001",
  "semester": 4,
  "year": 2
}

### 3.6 Faculty enters test marks: IAT 1, IAT 2, Model, Internal marks (Page C)
PUT {{baseUrl}}/academic/performance/111422104001/semester/4/marks
Authorization: Bearer {{facultyToken}}
Content-Type: application/json

{
  "subjectMarks": [
    {
      "subjectCode": "CS8401",
      "subjectName": "Operating Systems",
      "iat1": 88,
      "iat2": 92,
      "model": 89,
      "internalMark": 19
    },
    {
      "subjectCode": "CS8402",
      "subjectName": "Database Management Systems",
      "iat1": 94,
      "iat2": 96,
      "model": 95,
      "internalMark": 20
    }
  ]
}

### 3.7 Coordinator updates Semester Attendance (Page C)
PUT {{baseUrl}}/academic/performance/111422104001/semester/4/attendance
Authorization: Bearer {{coordToken}}
Content-Type: application/json

{
  "workingDays": 88,
  "daysPresent": 84,
  "daysAbsent": 4,
  "leaveDays": 2,
  "medicalLeave": 2
}

